; Engine configuration file.
config_version=5

[application]
config/name="Axel's Emergency Vehicles"
config/custom_user_dir_name="godot/app_userdata/Axels Utryckning"
config/use_custom_user_dir=true
run/main_scene="res://main.tscn"
run/max_fps=60
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="En lugn och vänlig utryckningsrunda för Axel."

[display]
window/tts/enable=true
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.11, 0.16, 0.2, 1)

[internationalization]
locale/fallback="en"
locale/translations=PackedStringArray("res://l10n/sv.po")
