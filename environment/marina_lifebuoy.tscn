[gd_scene format=3]

[sub_resource type="Shader" id="RingFinish"]
code = "shader_type spatial;
varying vec2 ring_plane;
void vertex() {
	ring_plane = VERTEX.xz;
}
void fragment() {
	float angle = atan(ring_plane.y, ring_plane.x);
	float offset = abs(fract(angle * 0.63661977) - .5);
	float band = 1.0 - smoothstep(.082, .098, offset);
	ALBEDO = mix(vec3(.94, .18, .025), vec3(.88, .86, .71), band);
	ROUGHNESS = mix(.61, .34, band);
}"

[sub_resource type="ShaderMaterial" id="RingMaterial"]
shader = SubResource("RingFinish")

[sub_resource type="StandardMaterial3D" id="Metal"]
albedo_color = Color(0.38, 0.43, 0.46, 1)
metallic = 0.68
roughness = 0.5

[sub_resource type="TorusMesh" id="Ring"]
material = SubResource("RingMaterial")
inner_radius = 0.21
outer_radius = 0.38
rings = 32
ring_segments = 12

[sub_resource type="Shader" id="GrabLineFinish"]
code = "shader_type spatial;
varying vec3 rope_point;
void vertex() {
	rope_point = VERTEX;
	float angle = atan(VERTEX.z, VERTEX.x);
	float span = .5 + .5 * cos(4.0 * angle);
	VERTEX.xz += normalize(VERTEX.xz) * mix(-.027, .037, span);
	VERTEX.y -= .008 + .015 * span;
}
void fragment() {
	float strands = .5 + .5 * sin(atan(rope_point.z, rope_point.x) * 144.0 + rope_point.y * 400.0);
	ALBEDO = mix(vec3(.43, .37, .25), vec3(.76, .69, .52), strands);
	ROUGHNESS = .94;
}"

[sub_resource type="ShaderMaterial" id="GrabLineMaterial"]
shader = SubResource("GrabLineFinish")

[sub_resource type="TorusMesh" id="GrabLine"]
material = SubResource("GrabLineMaterial")
inner_radius = 0.361
outer_radius = 0.379
rings = 80
ring_segments = 8

[sub_resource type="CylinderMesh" id="Pole"]
material = SubResource("Metal")
top_radius = 0.045
bottom_radius = 0.05
height = 1.5
radial_segments = 12
rings = 1

[sub_resource type="BoxMesh" id="Base"]
material = SubResource("Metal")
size = Vector3(0.24, 0.035, 0.24)

[sub_resource type="BoxMesh" id="Cradle"]
